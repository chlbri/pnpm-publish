{
  "name": "pnpm-publish",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  // 3 GB RAM for the container
  "runArgs": ["--memory=3g", "--memory-swap=3g", "--cpus=2"],
  "hostRequirements": {
    "memory": "3gb"
  },
  "postCreateCommand": "corepack use pnpm@latest && pnpm run ci",
  // Forward vitest --ui port, also Ollama
  "forwardPorts": [51204, 11434],
  "portsAttributes": {
    "51204": {
      "label": "Vitest UI",
      "onAutoForward": "notify"
    },
    "11434": {
      "label": "Ollama",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development",
    // Give Node.js ~2 GB for heap
    "NODE_OPTIONS": "--max-old-space-size=2048",
    // pnpm store inside the container (no cross-device issues)
    "PNPM_HOME": "/home/node/.local/share/pnpm"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "coverage-gutters.coverageFileNames": [".coverage/lcov.info"],
        "vitest.enable": true,
        "vitest.commandLine": "pnpm run test:only"
      },
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "dbaeumer.vscode-eslint",
        "oxc.oxc-vscode",
        "vitest.explorer",
        "ryanluker.vscode-coverage-gutters",
        "adam-bender.commit-message-editor",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "formulahendry.code-runner",
        "fill-labs.dependi",
        "orta.vscode-twoslash-queries",
        "typescriptteam.native-preview",
        "ms-ceintl.vscode-language-pack-fr",
        "anthropic.claude-code",
        "wix.vscode-import-cost",
        "steoates.autoimport",
        "christian-kohler.npm-intellisense"
      ]
    }
  }
}
